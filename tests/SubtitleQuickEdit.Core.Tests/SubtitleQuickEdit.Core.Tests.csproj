<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SubtitleQuickEdit.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test code uses the default analyzer set (the production projects use AllEnabledByDefault). -->
    <AnalysisMode>Default</AnalysisMode>
    <!-- Native.HardLink in WriterSupport.cs is a LibraryImport P/Invoke. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SubtitleQuickEdit.Core\SubtitleQuickEdit.Core.csproj" />
  </ItemGroup>

</Project>
